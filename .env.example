# Copy these names into the Vercel project environment variables.
# Never commit real values to this repo.

# Neon pooled connection string
DATABASE_URL=

# Anthropic API key, for bespoke section drafting and the review pass
ANTHROPIC_API_KEY=

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

