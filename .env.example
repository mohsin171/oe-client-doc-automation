# Copy these names into the Vercel project environment variables.
# Never commit real values to this repo.

# Neon pooled connection string
DATABASE_URL=

# Anthropic API key, for bespoke section drafting and the review pass
ANTHROPIC_API_KEY=

# Session signing secret. Required for sign-in. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Resend API key, for sending six digit sign-in codes
RESEND_API_KEY=
AUTH_EMAIL_FROM=Orca Edge <hello@orcaedge.io>

# Pre-launch only. When exactly 'true', the sign-in code is returned in the
# response so the first owner can get in before email is connected.
# Remove this before any real firm uses the system.
AUTH_DEV_ECHO=

# Transcription provider for the dictation door. Not yet chosen.
# DEEPGRAM_API_KEY=
