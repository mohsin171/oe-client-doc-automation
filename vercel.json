{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/documents.js": {
      "maxDuration": 60
    },
    "api/templates.js": {
      "maxDuration": 60
    },
    "api/output.js": {
      "maxDuration": 30
    }
  }
}
